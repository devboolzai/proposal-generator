# ============================================================
# proposal-generator (the salesperson-facing Vercel project)
#
# Copy to .env.local for `vercel dev`, or better: set these in
# Vercel and run `vercel env pull .env.local`.
# ============================================================

# Injected automatically when a Blob store is connected to the project.
# The SAME store must be connected to the proposal-sign project.
BLOB_READ_WRITE_TOKEN=

# resend.com. Sending from @boolzai.co.il needs the domain verified there
# (SPF/DKIM records in DNS) — until then Resend only delivers to the address
# the account was registered with.
RESEND_API_KEY=
MAIL_FROM="Boolzai <proposals@boolzai.co.il>"

# Guards every write endpoint. The generator sits on a public URL, so without
# this anyone who found it could create proposals in your Blob store.
# Any long random string.
APP_ACCESS_CODE=

# Where the client's signing link points — the OTHER Vercel project.
# Locally this is the second `vercel dev`, e.g. http://localhost:3001
SIGN_BASE_URL=https://sign.boolzai.co.il
