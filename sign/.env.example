# ============================================================
# proposal-sign (the client-facing Vercel project)
#
# Deployed separately from the generator, with Root Directory
# set to `sign`, so that a client never receives a URL that
# serves the generator's code.
# ============================================================

# Must be the SAME Blob store as the generator project — that shared store is
# the only thing connecting the two deployments.
BLOB_READ_WRITE_TOKEN=

# resend.com — same account and verified sender as the generator.
RESEND_API_KEY=
MAIL_FROM="Boolzai <proposals@boolzai.co.il>"

# Who inside Boolzai gets told that a proposal was signed.
OWNER_EMAIL=dev@boolzai.co.il
